{
  "extends": ["./eslint/eslint-defaults.json", "./eslint/eslint-babel.json"],
  "env": {
    "browser": true,
  },
  "overrides": [
    {
      "files": ["machine-learning/**/*.js"],
      "rules": {
        "indent": ["error", 4],
        "space-before-function-paren": "off",
        "no-console": "off",
        "no-unused-vars": ["error", { "varsIgnorePattern": "^(_|[A-Z_])" }],
      },
    },
    {
      "files": ["machine-learning/worker.js"],
      "globals": {
        "importScripts": false,
        "tf": false
      },
    },
  ],
}
